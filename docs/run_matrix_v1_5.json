    "parametric_umap",
    "identity",
    "linear_head"
  ],
  "core_paired_baselines": [
    "single_seed",
    "best_of_n",
    "naive_average",
    "procrustes",
    "bertopic"
  ],
  "primary_test_metrics": [
    "trustworthiness",
    "distance_correlation",
    "silhouette_holdout",
    "ari_adapted_stage10"
  ],
  "supporting_metrics": [
    "source_separability_silhouette",
    "occupancy_kl",
    "occupancy_wasserstein1"
  ],
  "kf_only_supporting_metrics": [
    "cross_encoder_procrustes_disparity"
  ],
  "metric_recipe_notes": {
    "trustworthiness": "k=15, cosine (protocol section 18.e); training-independent for all methods",
    "distance_correlation": "condensed-vector recipe (registered recipe id distance_correlation: Pearson r between condensed unique-pair distance vectors; NOT Szekely dCorr and NOT the dist_corr_loss full-matrix training-loss recipe - see v1.5 clause m)",
    "silhouette_holdout": "silhouette of held-out projections under nearest-centroid labels",
    "ari_adapted_stage10": "adapted Stage-10 ARI: held-out KMeans vs full-rerun KMeans on the same held-out"
  },
  "metric_roles": {
    "trustworthiness": {
      "cross_method": "primary",
      "head_vs_head": "primary"
    },
    "distance_correlation": {
      "cross_method": "training-objective-aligned, supporting",
      "head_vs_head": "primary"
    },
    "silhouette_holdout": {
      "cross_method": "supporting",
      "head_vs_head": "supporting"
    },
    "ari_adapted_stage10": {
      "cross_method": "supporting",
      "head_vs_head": "supporting"
    }
  },
  "replicate_rule": "Random-split strategies (T5, K2-T4, K2-T5) aggregate each metric across their replicates to the per-seed mean BEFORE any paired test, so every strategy contributes exactly one 30-value column per metric per method and the family sizes below are exact.",
  "family_correction": "Holm-Bonferroni within each family; Benjamini-Hochberg FDR reported alongside as a sensitivity check (protocol section 8). Primary/supporting role marks say which comparisons carry headline claims; ALL enumerated tests are family members regardless of role.",
